-- GameData String64 values. Each entry is three FixedSafeString&lt;64&gt; (0x108 bytes); the live value is the second.
-- The block moves between boots, so it is found through the hash-table entry of Sequence_CurrentBanc
-- (murmur3 0x1D6189DA, index 0x1F); its values start 0x207C after that entry.
GD_IDX = {cur = 0x1F, event = 0x20, starter = 0x21, banc = 0x22, pos = 0x23,
          shield2 = 0x0E, weapon2 = 0x0F, armor = 0x10, arrow = 0x11, boot = 0x12, ocarina = 0x15, shield = 0x16, weapon = 0x17}

function gdFind()
  if GD_BASE and (readString(GD_BASE + 0x1F * 0x108, 64) or '') ~= '' then return GD_BASE end
  local ms = createMemScan()
  ms.firstScan(soExactValue, vtByteArray, nil, 'DA 89 61 1D 1F 00 00 00', nil,
               LT.gb + 0x2180000000, LT.gb + 0x2190000000, '', fsmAligned, '8', true, false, false, false)
  ms.waitTillDone()
  local fl = createFoundList(ms) fl.initialize()
  for i = 0, fl.Count - 1 do
    local cur = tonumber(fl.getAddress(i), 16) + 0x207C
    local name = readString(cur, 64) or ''
    if name:match('^[%w_]+$') and #name &gt; 3 then GD_BASE = cur - 0x1F * 0x108 break end
  end
  fl.destroy() ms.destroy()
  if GD_BASE then registerSymbol('gdstr', GD_BASE, true) end
  return GD_BASE
end

TRAVEL_SLOT = setmetatable({}, {__index = function(_, k) return GD_IDX[k] and (GD_BASE - LT.gb) + GD_IDX[k] * 0x108 end})

-- memscan freezes CE on its GUI thread, so searches run in a worker thread.
function gdFindAsync()
  if GD_BUSY then return end
  GD_BUSY = true
  createThread(function() pcall(gdFind) GD_BUSY = false end)
end

local function tvOk()
  if GD_BASE and (readString(GD_BASE + 0x1F * 0x108, 64) or '') ~= '' then return true end
  GD_BASE = nil gdFindAsync()
  return false
end
local function tvGet(k) return readString(LT.gb + TRAVEL_SLOT[k], 64) or '' end
local function tvPut(k, s)
  local b = {} for i = 1, 64 do b[i] = 0 end
  for i = 1, math.min(#s, 63) do b[i] = s:byte(i) end
  writeBytes(LT.gb + TRAVEL_SLOT[k], b)
end

-- Waits for any exit to reserve a map change, then swaps in the chosen map and spawn point.
function travelArm(banc, pos, event)
  if not tvOk() then showMessage('Travel: still locating the game data, try again in a few seconds') return end
  if TRAVEL_TIMER then TRAVEL_TIMER.destroy() TRAVEL_TIMER = nil end
  tvPut('banc', '')
  local t0 = getTickCount()
  TRAVEL_TIMER = createTimer(nil, false)
  TRAVEL_TIMER.Interval = 5
  TRAVEL_TIMER.OnTimer = function(t)
    if getTickCount() - t0 &gt; 300000 then t.destroy() TRAVEL_TIMER = nil return end
    if tvGet('banc') ~= '' then
      tvPut('banc', banc) tvPut('pos', pos) tvPut('starter', pos) tvPut('event', event)
      t.destroy() TRAVEL_TIMER = nil
    end
  end
  TRAVEL_TIMER.Enabled = true
  -- Put Link into the nearest exit of the current map so the change starts right away.
  local cur = tvGet('cur')
  local x, y, z = ltDisplayPos()
  local best, bd = nil, 1e18
  for _, c in ipairs(TRAVEL_EXITS[cur] or {}) do
    local d = (c[1] - (x or 0))^2 + (c[3] - (z or 0))^2
    if d &lt; bd then best, bd = c, d end
  end
  if best and LT.linkpos then linkTeleport(best[1], best[2], best[3]) end
end

function travelForm()
  gdFindAsync()
  if TRAVEL_FORM then TRAVEL_FORM.show() return end
  local f = createForm(false)
  f.Caption = 'Travel' f.Width = 520 f.Height = 460 f.Position = 'poScreenCenter'
  local maps = createComboBox(f) maps.Left = 8 maps.Top = 8 maps.Width = 500 maps.Style = 'csDropDownList'
  local names = {} for k in pairs(TRAVEL_SPAWNS) do table.insert(names, k) end table.sort(names)
  for _, n in ipairs(names) do maps.Items.add(n) end
  local list = createListBox(f) list.Left = 8 list.Top = 40 list.Width = 500 list.Height = 340
  local go = createButton(f) go.Left = 8 go.Top = 390 go.Width = 500 go.Height = 32 go.Caption = 'Travel (Link is put into the nearest exit; or walk into any exit)'
  maps.OnChange = function()
    list.Items.clear()
    for _, r in ipairs(TRAVEL_SPAWNS[names[maps.ItemIndex + 1]] or {}) do list.Items.add(r[1] .. '   (' .. r[3] .. ')') end
  end
  go.OnClick = function()
    if maps.ItemIndex &lt; 0 or list.ItemIndex &lt; 0 then showMessage('Pick a map and a spawn point') return end
    local banc = names[maps.ItemIndex + 1]
    local r = TRAVEL_SPAWNS[banc][list.ItemIndex + 1]
    travelArm(banc, r[1], r[2])
  end
  f.OnClose = function() return caHide end
  TRAVEL_FORM = f
  f.show()
end

ltStart()
gdFindAsync()
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if ltStop then ltStop() end
{$asm}
</AssemblerScript></CheatEntry>
<CheatEntry><ID>2</ID><Description>"Moonjump (hold Space = up, Ctrl = down; edit script for keys/pad/speed)"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if not (LT and LT.fast) then error("Enable 'Link tools' first") end
-- speed = units per second
-- keys: VK_ codes, e.g. VK_SPACE, VK_SHIFT, VK_CONTROL, VK_E, VK_XBUTTON1
-- pad: XInput button name or nil, e.g. 'GAMEPAD_A', 'GAMEPAD_B', 'GAMEPAD_X', 'GAMEPAD_Y',
--      'GAMEPAD_LEFT_SHOULDER', 'GAMEPAD_RIGHT_SHOULDER', 'GAMEPAD_LEFT_THUMB'
MJ = MJ or {}
MJ.speed = 12.0
MJ.key = VK_SPACE
MJ.downKey = VK_CONTROL
MJ.pad = nil
MJ.downPad = nil
MJ.enabled = true
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if MJ then MJ.enabled = false end
{$asm}
</AssemblerScript></CheatEntry>
<CheatEntry><ID>3</ID><Description>"Speed multiplier (x2; edit script for value / hold key)"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if not (LT and LT.fast) then error("Enable 'Link tools' first") end
-- mult: 2.0 = double speed, 0.5 = half. key: nil = always on, or e.g. VK_SHIFT = only while held
SP = SP or {}
SP.mult = 2.0
SP.key = nil
SP.enabled = true
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if SP then SP.enabled = false end
{$asm}
</AssemblerScript></CheatEntry>
<CheatEntry><ID>4</ID><Description>"Free camera (numpad 8456 move, 9/3 up/down, right mouse = look)"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if not (LT and LT.gb) then error("Enable 'Link tools' first") end
-- numpad 8/5 forward/back, 4/6 left/right, 9/3 up/down, numpad + faster, hold right mouse button to look
FC.speed = 12.0
fcStart()
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if fcStop then fcStop() end
