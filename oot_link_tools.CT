<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
<CheatEntries>
<CheatEntry><ID>1</ID><Description>"Link tools (enable first; also opens cepipe for the viewer)"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- Offsets are relative to the main module base (LT.M), which moves between emulator builds.
LT = LT or {}
LT.DATA_OFF = 0x484D000
LT.CHECK_OFF, LT.CHECK_VAL_OFF = 0x4C7EFE0, 0x4DD71A0
LT.VT_LINKOBJ_OFF, LT.VT_PARAM_OFF = 0x4B25E18, 0x4B63438
LT.DISP_OFF = 0x4C7E740
LT.LINKOBJ_PTRS = { {0x4E371D0,0x480}, {0x4E94858,0x2E0}, {0x4E935B8,0xEF8}, {0x4E94860,0x328}, {0x4E94368,0xD70} }
MJ = MJ or { enabled=false, speed=12.0, key=VK_SPACE, downKey=VK_CONTROL, pad=nil, downPad=nil }
SP = SP or { enabled=false, mult=2.0, key=nil }

local function q(a) return a and readQword(a) end
local function gq(g) return LT.gb and g and readQword(LT.gb + g) end

local function linkObjAt(c, M)
  for _,p in ipairs(LT.LINKOBJ_PTRS) do
    local st = readQword(c + M + p[1])
    local o = st and readQword(c + st + p[2])
    if o and readQword(c + o) == M + LT.VT_LINKOBJ_OFF then return o end
  end
end

local function validBase(c, M)
  if not (c and M) or c &lt;= 0 then return false end
  if readQword(c + M + LT.CHECK_OFF) ~= M + LT.CHECK_VAL_OFF then return false end
  if linkObjAt(c, M) then return true end
  local G = readQword(c + M + LT.DISP_OFF)
  local Q = G and readQword(c + G)
  return Q ~= nil and readFloat(c + Q + 0x29C) ~= nil
end

function ltFindGuestBase()
  if validBase(LT.gb, LT.M) then return LT.gb, LT.M end
  for _,r in ipairs(enumMemoryRegions()) do
    local H = r.BaseAddress
    local v = readQword(H + (LT.CHECK_OFF - LT.DATA_OFF))
    if v and v &gt; LT.CHECK_VAL_OFF then
      local M = v - LT.CHECK_VAL_OFF
      if M % 0x1000 == 0 then
        local c = H - (M + LT.DATA_OFF)
        if validBase(c, M) then
          registerSymbol("guestbase", c, true)
          registerSymbol("gamemain", c + M, true)
          return c, M
        end
      end
    end
  end
  return nil
end

function ltLinkObj()
  return LT.gb and linkObjAt(LT.gb, LT.M)
end

function ltDisplayPos()
  local Q = gq(gq(LT.M + LT.DISP_OFF))
  if not Q then return nil end
  local a = LT.gb + Q + 0x29C
  return readFloat(a), readFloat(a+4), readFloat(a+8)
end

local function setSym(name, addr)
  if addr ~= LT[name] then
    if addr then registerSymbol(name, addr, true) else pcall(unregisterSymbol, name) end
    LT[name] = addr
  end
end

function ltUpdateHealth()
  local o = ltLinkObj()
  setSym("linkobj", o and LT.gb + o)
  local o2 = o and gq((gq(o + 8) or 0) + 0x6A0)
  local p, m = o2 and gq(o2 + 0x1C10), o2 and gq(o2 + 0x1C18)
  if p and gq(p) == LT.M + LT.VT_PARAM_OFF then setSym("linkhp", LT.gb + p + 8) else setSym("linkhp", nil) end
  local cam = p and LT.gb + p + 0x978
  if cam and o then
    local cx, cy, cz = readFloat(cam), readFloat(cam + 4), readFloat(cam + 8)
    local lx, ly, lz = readFloat(LT.gb + o + 0x31C), readFloat(LT.gb + o + 0x320), readFloat(LT.gb + o + 0x324)
    if not (cx and lx and math.abs(cx - lx) + math.abs(cy - ly) + math.abs(cz - lz) &lt; 60) then cam = nil end
  end
  setSym("linkcam", cam)
  if m and gq(m) == LT.M + LT.VT_PARAM_OFF then setSym("linkhpmax", LT.gb + m + 8) end
end

function ltFindPos()
  local x, y, z = ltDisplayPos()
  if not x then return nil end
  -- Coordinates near 0 match too many doubles, so scan the largest one.
  local axes = { {x, 0}, {y + 0.585, 8}, {z, 0x10} }
  table.sort(axes, function(p, q) return math.abs(p[1]) &gt; math.abs(q[1]) end)
  local v, off = axes[1][1], axes[1][2]
  local function scan(lo, hi, w)
    local ms = createMemScan()
    ms.firstScan(soValueBetween, vtDouble, rtRounded, string.format("%.6f", v-w), string.format("%.6f", v+w), lo, hi, "+W", fsmAligned, "8", false, false, false, false)
    ms.waitTillDone()
    local fl = createFoundList(ms) fl.initialize()
    local c
    if fl.Count &lt;= 20000 then
      c = {}
      for i=0, fl.Count-1 do
        local a = tonumber(fl.getAddress(i), 16) - off
        local px, py, pz = readDouble(a), readDouble(a+8), readDouble(a+0x10)
        if px and py and pz and math.abs(px - x) &lt; 3 and math.abs(pz - z) &lt; 3 and math.abs(py - y - 0.585) &lt; 3 then table.insert(c, {a=a, s=0}) end
      end
    end
    fl.destroy() ms.destroy()
    return c
  end
  local function scanRange(lo, hi)
    for _,w in ipairs({3, 0.75, 0.2}) do
      local c = scan(lo, hi, w)
      if c then return c end
    end
    return {}
  end
  local c = scanRange(LT.gb + 0x2100000000, LT.gb + 0x2300000000)
  if #c == 0 then c = scanRange(LT.gb + 0x2000000000, LT.gb + 0x4000000000) end
  if #c == 0 then return nil end
  for n=1,6 do
    local dx, dy, dz = ltDisplayPos()
    if not (dx and dy and dz) then return nil end
    for _,e in ipairs(c) do
      local px, py, pz = readDouble(e.a), readDouble(e.a+8), readDouble(e.a+0x10)
      if px and py and pz then e.s = e.s + math.abs(px-dx) + math.abs(pz-dz) + math.abs(py-dy-0.585) else e.s = e.s + 1e9 end
    end
    sleep(20)
  end
  table.sort(c, function(p, q) return p.s &lt; q.s end)
  local good = {}
  for _,e in ipairs(c) do if e.s / 6 &lt; 0.3 then table.insert(good, e.a) end end
  if LT.debug then for _,e in ipairs(c) do if e.s/6 &lt; 0.3 then LT.debug(string.format("cand %X score=%.4f", e.a - LT.gb, e.s/6)) end end end
  if #good == 0 then return nil end
  -- Only the record that drives Link moves the displayed position when nudged.
  local NUDGE, best = 0.3, nil
  for i=1, math.min(#good, 10) do
    local a = good[i]
    local p0 = ltDisplayPos() sleep(150) local p1 = ltDisplayPos()
    local nudged = readDouble(a) + NUDGE
    writeDouble(a, nudged)
    sleep(150)
    local p2 = ltDisplayPos()
    if not (p0 and p1 and p2) then return nil end
    local gain = (p2 - p1) - (p1 - p0)
    if LT.debug then LT.debug(string.format("test %X gain=%.3f", a - LT.gb, gain)) end
    if gain &gt; NUDGE * 0.5 then
      writeDouble(a, readDouble(a) - NUDGE)
      best = a break
    end
    local v = readDouble(a)
    if v and math.abs(v - nudged) &lt; 0.05 then writeDouble(a, v - NUDGE) end
    sleep(30)
  end
  if not best then return nil end
  LINKPOS_ALL = { best }
  for _,a in ipairs(good) do if a ~= best then table.insert(LINKPOS_ALL, a) end end
  setSym("linkpos", best)
  return best
end

function linkTeleport(nx, ny, nz)
  local b = LT.linkpos
  if not b then return end
  local dx, dy, dz = nx - readDouble(b), ny + 0.585 - readDouble(b+8), nz - readDouble(b+0x10)
  for _,a in ipairs(LINKPOS_ALL or { b }) do
    writeDouble(a, readDouble(a) + dx) writeDouble(a+8, readDouble(a+8) + dy) writeDouble(a+0x10, readDouble(a+0x10) + dz)
  end
end

local function posOk()
  local x, y, z = ltDisplayPos()
  if not x then return false end
  if not LT.linkpos or not LINKPOS_ALL then return false end
  for _,a in ipairs(LINKPOS_ALL) do
    local px, pz = readDouble(a), readDouble(a+0x10)
    if not (px and pz) or math.abs(px - x) &gt; 3 or math.abs(pz - z) &gt; 3 then return false end
  end
  return true
end

-- memscan and sleep on CE's GUI thread freeze CE.
function ltSlowTick()
  local now = getTickCount()
  if LT.busy and now - (LT.busySince or 0) &lt; 30000 then return end
  LT.busy, LT.busySince = true, now
  createThread(function()
    local ok, e = pcall(ltSlowTickInner)
    LT.finding = false
    LT.busy = false
    if not ok then LT.lastErr = tostring(e) end
  end)
end

function ltSlowTickInner()
  if not validBase(LT.gb, LT.M) then LT.gb, LT.M = ltFindGuestBase() if not LT.gb then return end end
  ltUpdateHealth()
  local now = getTickCount()
  local x, y, z = ltDisplayPos()
  -- A big jump means a zone change: re-find once loading settles.
  if x and LT.lastX and (math.abs(x - LT.lastX) + math.abs(z - LT.lastZ) &gt; 15) then
    LT.zoneChangedAt = now
  end
  if x then LT.lastX, LT.lastZ = x, z end
  local need = not posOk()
  if LT.zoneChangedAt and now - LT.zoneChangedAt &gt; 1500 then need, LT.zoneChangedAt, LT.forceFind = true, nil, true end
  if need then
    LT.bad = (LT.bad or 0) + 1
    if (LT.bad &gt;= 2 or LT.forceFind) and now - (LT.lastFind or 0) &gt; 2000 then
      LT.lastFind = now
      MJ.active = false
      LT.finding = true
      local p = ltFindPos()
      LT.finding = false
      if p then LT.bad, LT.forceFind = 0, false
      else LT.forceFind = true LINKPOS_ALL = nil setSym("linkpos", nil) end
    end
  else LT.bad = 0 end
end

local function padHeld(name)
  if not name then return false end
  local ok, st = pcall(getXBox360ControllerState, 0)
  return ok and st and st[name] == true
end

function ltMoonTick()
  if LT.finding or not MJ.enabled or not LT.linkpos then MJ.active = false return end
  local up = isKeyPressed(MJ.key) or padHeld(MJ.pad)
  local down = (MJ.downKey and isKeyPressed(MJ.downKey)) or padHeld(MJ.downPad)
  local now = getTickCount()
  if up or down then
    if not MJ.active then
      MJ.active, MJ.t, MJ.lift, MJ.base = true, now, 0, {}
      for _,a in ipairs(LINKPOS_ALL or { LT.linkpos }) do MJ.base[a] = readDouble(a + 8) end
    end
    local dt = math.min(now - MJ.t, 100) / 1000
    MJ.lift = MJ.lift + (up and MJ.speed or -MJ.speed) * dt
    MJ.t = now
    for a, y0 in pairs(MJ.base) do writeDouble(a + 8, y0 + MJ.lift) end
  else
    MJ.active = false
  end
end

function ltSpeedTick()
  local b = LT.linkpos
  if LT.finding or not SP.enabled or not b or (SP.key and not isKeyPressed(SP.key)) then SP.last = nil return end
  local x, z = readDouble(b), readDouble(b + 0x10)
  if not (x and z) then SP.last = nil return end
  local l = SP.last
  if l and l.b == b then
    local dx, dz = x - l.x, z - l.z
    local d = math.abs(dx) + math.abs(dz)
    if d &gt; 0.0005 and d &lt; 2 then
      local k = SP.mult - 1
      for _,a in ipairs(LINKPOS_ALL or { b }) do
        writeDouble(a, readDouble(a) + dx * k) writeDouble(a + 0x10, readDouble(a + 0x10) + dz * k)
      end
      x, z = x + dx * k, z + dz * k
    end
  end
  SP.last = { b=b, x=x, z=z }
end

-- linkcalc: +0 speed xz, +4 speed 3D, +8 accel xz, +C heading, +10 vertical speed, +14 camera yaw, +18 camera pitch, +1C camera distance
function ltCalcTick()
  local o, c = LT.linkobj, LT.linkcalc
  if not (o and c) then return end
  local vx, vy, vz = readFloat(o + 0x388), readFloat(o + 0x38C), readFloat(o + 0x390)
  if not (vx and vy and vz) then return end
  local h = math.sqrt(vx*vx + vz*vz)
  writeFloat(c, h) writeFloat(c + 4, math.sqrt(vx*vx + vy*vy + vz*vz)) writeFloat(c + 0x10, vy)
  local fx, fz = readFloat(o + 0x330), readFloat(o + 0x328)
  if fx and fz then writeFloat(c + 0xC, math.deg(math.atan(fx, fz))) end
  local cam = LT.linkcam
  if cam then
    local dx, dy, dz = readFloat(cam) - readFloat(o + 0x31C), readFloat(cam + 4) - readFloat(o + 0x320), readFloat(cam + 8) - readFloat(o + 0x324)
    local hd = math.sqrt(dx*dx + dz*dz)
    writeFloat(c + 0x14, math.deg(math.atan(-dx, -dz)))
    writeFloat(c + 0x18, math.deg(math.atan(-dy, hd)))
    writeFloat(c + 0x1C, math.sqrt(hd*hd + dy*dy))
  end
  local now = getTickCount()
  if not LT.accT then LT.accT, LT.accV = now, h end
  if now - LT.accT &gt;= 100 then
    writeFloat(c + 8, (h - LT.accV) * 1000 / (now - LT.accT))
    LT.accT, LT.accV = now, h
  end
end

function ltFastTick()
  pcall(ltMoonTick)
  pcall(ltSpeedTick)
  pcall(ltCalcTick)
end

-- Free camera: the game rebuilds its camera every frame, so a worker thread keeps overwriting
-- the view matrix (+8, 3x4 rows), position (+0x38) and look-at (+0x44) of [[main+4E98068]+0x68].
FC = FC or { enabled=false, speed=12.0 }

local function fcCam()
  local p = gq(LT.M + 0x4E98068)
  local c = p and gq(p + 0x68)
  return c and LT.gb + c
end

function fcStart()
  if FC.thread then return end
  local c = fcCam()
  if not c then error("camera not found") end
  local ex, ey, ez = readFloat(c + 0x38), readFloat(c + 0x3C), readFloat(c + 0x40)
  local tx, ty, tz = readFloat(c + 0x44), readFloat(c + 0x48), readFloat(c + 0x4C)
  local dx, dy, dz = tx - ex, ty - ey, tz - ez
  local l = math.sqrt(dx*dx + dy*dy + dz*dz)
  FC.pos = { ex, ey, ez }
  FC.yaw = math.atan(dx, dz)
  FC.pitch = math.asin(dy / l)
  FC.enabled = true
  FC.thread = createThread(function()
    local ok, e = pcall(fcLoop)
    if not ok then FC.err = tostring(e) end
    FC.thread = nil
  end)
end

function fcLoop()
    local last, mx, my = getTickCount(), nil, nil
    while FC.enabled do
      local now = getTickCount()
      local dt = math.min(now - last, 100) / 1000
      last = now
      if isKeyPressed(VK_RBUTTON) then
        local x, y = getMousePos()
        if mx then
          FC.yaw = FC.yaw - (x - mx) * 0.004
          FC.pitch = math.max(-1.5, math.min(1.5, FC.pitch - (y - my) * 0.004))
        end
        mx, my = x, y
      else mx = nil end
      local fx, fy, fz = math.sin(FC.yaw) * math.cos(FC.pitch), math.sin(FC.pitch), math.cos(FC.yaw) * math.cos(FC.pitch)
      local rx, rz = -math.cos(FC.yaw), math.sin(FC.yaw)
      local sp = FC.speed * dt * (isKeyPressed(VK_ADD) and 4 or 1)
      local p = FC.pos
      if isKeyPressed(VK_NUMPAD8) then p[1], p[2], p[3] = p[1] + fx*sp, p[2] + fy*sp, p[3] + fz*sp end
      if isKeyPressed(VK_NUMPAD5) then p[1], p[2], p[3] = p[1] - fx*sp, p[2] - fy*sp, p[3] - fz*sp end
      if isKeyPressed(VK_NUMPAD6) then p[1], p[3] = p[1] + rx*sp, p[3] + rz*sp end
      if isKeyPressed(VK_NUMPAD4) then p[1], p[3] = p[1] - rx*sp, p[3] - rz*sp end
      if isKeyPressed(VK_NUMPAD9) then p[2] = p[2] + sp end
      if isKeyPressed(VK_NUMPAD3) then p[2] = p[2] - sp end
      -- view rows: right, up, back; translation = -R * eye
      local ux, uy, uz = -rz * fy, rz * fx - rx * fz, rx * fy
      local ul = math.sqrt(ux*ux + uy*uy + uz*uz)
      ux, uy, uz = ux / ul, uy / ul, uz / ul
      local R = { rx, 0, rz, ux, uy, uz, -fx, -fy, -fz }
      local c = fcCam()
      if c then
        for i = 0, 2 do
          local a, b, d = R[i*3+1], R[i*3+2], R[i*3+3]
          writeFloat(c + 8 + i*16, a) writeFloat(c + 12 + i*16, b) writeFloat(c + 16 + i*16, d)
          writeFloat(c + 20 + i*16, -(a*p[1] + b*p[2] + d*p[3]))
        end
        writeFloat(c + 0x38, p[1]) writeFloat(c + 0x3C, p[2]) writeFloat(c + 0x40, p[3])
        writeFloat(c + 0x44, p[1] + fx) writeFloat(c + 0x48, p[2] + fy) writeFloat(c + 0x4C, p[3] + fz)
      end
      sleep(0)
    end
end

function fcStop() FC.enabled = false end

function ltStart()
  ltStop()
  if not LT.pipe then LT.pipe = pcall(openLuaServer, "cepipe") end
  LT.gb, LT.M = ltFindGuestBase()
  if not LT.gb then error("guestbase not found (is the game running?)") end
  LT.linkpos, LT.busy, LT.finding, LT.lastFind, LT.forceFind = nil, false, false, 0, true
  ltUpdateHealth()
  if not LT.linkcalc then LT.linkcalc = allocateMemory(0x100) registerSymbol("linkcalc", LT.linkcalc, true) end
  LT.slow = createTimer(nil, false) LT.slow.Interval = 500
  LT.slow.OnTimer = function()
    local ok, e = pcall(ltSlowTick)
    if not ok then print("LinkTools: " .. tostring(e)) end
    if LT.lastErr then print("LinkTools: " .. LT.lastErr) LT.lastErr = nil end
  end
  LT.slow.Enabled = true
  LT.fast = createTimer(nil, false) LT.fast.Interval = 15
  LT.fast.OnTimer = function() ltFastTick() end
  LT.fast.Enabled = true
  print(string.format("LinkTools: guestbase=%X main=%X hp=%X (position search running in background)", LT.gb, LT.M, LT.linkhp or 0))
end

function ltStop()
  if LT.slow then LT.slow.destroy() LT.slow = nil end
  if LT.fast then LT.fast.destroy() LT.fast = nil end
end

TRAVEL_SPAWNS = {
  ["BarinadeStage"] = {{"BarinadeStage", "Dm_SY_BancChangeArrive", "other spawn point"}, {"StartPos_SubEvent_AllBossBattle", "Dm_SY_BancChangeArrive", "other spawn point"}},
  ["BigOctoStage"] = {{"BigOctoStage", "Dm_SY_BancChangeArrive", "other spawn point"}, {"StartPos_SubEvent_AllBossBattle", "Dm_SY_BancChangeArrive", "other spawn point"}},
  ["BongoBongoStage"] = {{"BongoBongoStage", "Dm_SY_BancChangeArrive", "other spawn point"}, {"StartPos_SageOfShadow", "Dm_SY_BancChangeArrive", "other spawn point"}, {"StartPos_SubEvent_AllBossBattle", "Dm_SY_BancChangeArrive", "other spawn point"}},
  ["BossRushIntervalRoom"] = {{"BossRush", "Dm_SY_BancChangeArrive", "other spawn point"}, {"StartPos_SubEvent_AllBossBattle", "Dm_SY_BancChangeArrive", "other spawn point"}},
  ["BottomOfTheWell"] = {{"StartPos_SubEvent_GetStormSong", "Dm_SY_BancChangeArrive", "other spawn point"}, {"StartPos_SubEvent_GetStormSong_BeforeBossRoom", "Dm_SY_BancChangeArrive", "other spawn point"}, {"Well_KakarikoSide", "Dm_SY_BancChangeArrive", "from KakarikoVillage_Adult_Alternative"}},
  ["CrumblingGanonCastle"] = {{"BackEntrance", "Dm_SY_BancChangeArrive", "other spawn point"}, {"CrumblingGanonCastle_StartPos", "Dm_SY_BancChangeArrive", "other spawn point"}, {"RestartPos1", "Dm_SY_BancChangeArrive", "other spawn point"}, {"RestartPos2", "Dm_SY_BancChangeArrive", "other spawn point"}, {"RestartPos3", "Dm_SY_BancChangeArrive", "other spawn point"}, {"RestartPos4", "Dm_SY_BancChangeArrive", "other spawn point"}, {"RestartPos5", "Dm_SY_BancChangeArrive", "other spawn point"}, {"RestartPos6", "Dm_SY_BancChangeArrive", "other spawn point"}, {"RestartPos7", "Dm_SY_BancChangeArrive", "other spawn point"}, {"RestartPos_Ganondorf_BossBattle", "Dm_SY_BancChangeArrive", "other spawn point"}, {"StartPos_Defeat_Ganon", "Dm_SY_BancChangeArrive", "other spawn point"}},
  ["DarkLinkStage"] = {{"DarkLinkStage", "Dm_SY_BancChangeArrive", "other spawn point"}, {"StartPos_SubEvent_AllBossBattle", "Dm_SY_BancChangeArrive", "other spawn point"}},
  ["DeadHandStage"] = {{"DeadHandStage", "Dm_SY_BancChangeArrive", "other spawn point"}, {"StartPos_SubEvent_AllBossBattle", "Dm_SY_BancChangeArrive", "other spawn point"}},
  ["DeathMountainCrater_Adult"] = {{"Crater_GoronCitySide", "DeathMountainCrater_Arrive", "from GoronCity_Adult"}, {"Crater_MountainTrailSide", "DeathMountainCrater_Arrive", "from DeathMountainTrail_Adult"}, {"EntrancePos_FireTemple", "Dm_SY_BancChangeArrive", "other spawn point"}, {"EntrancePos_GoronCity", "Dm_SY_BancChangeArrive", "other spawn point"}, {"EntrancePos_MountainTrail", "Dm_SY_BancChangeArrive", "other spawn point"}, {"FireBolero", "Dm_SY_BancChangeArrive", "other spawn point"}, {"OutsideOfFireTemple", "Dm_SY_BancChangeArrive_DeathMountainCrater_02", "from FireTemple"}},
