<CheatEntry><ID>15</ID><Description>"Travel to another map (opens a window: pick map + spawn point)"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if not (LT and LT.gb and travelForm) then error("Enable 'Link tools' first") end
travelForm()
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if TRAVEL_FORM then TRAVEL_FORM.hide() end
{$asm}
</AssemblerScript></CheatEntry>
